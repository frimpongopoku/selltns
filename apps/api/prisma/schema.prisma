generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum PaymentMethodType {
  MOMO
  BANK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  MODIFIED
  CANCELLED
  COMPLETED
}

enum CollectionType {
  STANDARD
  PREORDER
}

enum OrderType {
  STANDARD
  PREORDER
}

enum DepositType {
  FULL
  PERCENTAGE
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlanTier {
  FREE
  GROWTH
  PRO
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  DECLINED
  TERMINATED
}

// FIXED = a flat GHS ceiling the affiliate can add on top of the owner's
// price; PERCENTAGE = a ceiling expressed as a percentage of it instead.
enum AffiliateCapType {
  FIXED
  PERCENTAGE
}

enum OrderSource {
  DIRECT
  AFFILIATE
}

model Tenant {
  id                         String   @id @default(cuid())
  name                       String
  slug                       String   @unique
  logoUrl                    String?  @map("logo_url")
  customDomain               String?  @map("custom_domain")
  domainVerified             Boolean  @default(false) @map("domain_verified")
  whatsappNumber             String?  @map("whatsapp_number")
  ownerDisplayName           String   @default("") @map("owner_display_name")
  ownerTitle                 String   @default("") @map("owner_title")
  ownerBio                   String   @default("") @map("owner_bio")
  ownerInfoVisible           Boolean  @default(false) @map("owner_info_visible")
  // A public contact email the vendor explicitly opts into showing — kept
  // separate from any account/login email so nothing is disclosed without
  // an explicit, deliberate choice (same "off by default" model as
  // ownerInfoVisible above).
  contactEmail               String?  @map("contact_email")
  contactSectionVisible      Boolean  @default(false) @map("contact_section_visible")
  // Shows a "don't see what you want? message us on WhatsApp" banner on
  // the storefront, for custom/bespoke order requests — off by default,
  // and has no effect unless whatsappNumber is also set.
  bespokeRequestsEnabled     Boolean  @default(false) @map("bespoke_requests_enabled")
  // Whether this tenant's own storefront footer discloses its affiliate
  // relationships (both directions — shops it resells for, and shops
  // reselling its products). Each tenant only ever controls disclosure of
  // its own relationships, never the other party's.
  affiliateDisclosureVisible Boolean  @default(true) @map("affiliate_disclosure_visible")
  heroTagline                String   @default("Small-batch, handmade pieces. Request your favorites and we'll confirm before arranging payment.") @map("hero_tagline")
  footerTagline              String   @default("Handmade, made-to-order pieces. Requested here, confirmed by us, paid your way.") @map("footer_tagline")
  storyBlocks                Json     @default("[]") @map("story_blocks")
  themeTokens                Json     @map("theme_tokens")
  createdAt                  DateTime @default(now()) @map("created_at")

  verificationStatus VerificationStatus @default(NONE) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  suspended          Boolean            @default(false)
  suspendedAt        DateTime?          @map("suspended_at")
  suspendedReason    String?            @map("suspended_reason")

  // Billing is enforced nowhere yet — this just records which plan a tenant
  // is on so the limits can be turned on later without another migration.
  // Tenants that existed before plan billing shipped are backfilled to PRO
  // (see the add_billing_plans migration) so nothing changes for them.
  plan          PlanTier  @default(FREE)
  planUpdatedAt DateTime? @map("plan_updated_at")

  memberships         TenantMembership[]
  mediaAssets         MediaAsset[]
  products            Product[]
  collections         Collection[]
  paymentMethods      PaymentMethod[]
  orders              Order[]
  verificationRequest VerificationRequest?
  upgradeRequests     UpgradeRequest[]

  affiliateRelationshipsAsOwner     AffiliateRelationship[] @relation("AffiliateAsOwner")
  affiliateRelationshipsAsAffiliate AffiliateRelationship[] @relation("AffiliateAsAffiliate")

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  googleSub    String?  @unique @map("google_sub")
  lastTenantId String?  @map("last_tenant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // A superadmin can verify a *person*, not just one of their shops — see
  // SuperAdminService.verifyUser(), which cascades this onto
  // Tenant.verificationStatus for every shop where this user is OWNER.
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at")

  memberships TenantMembership[]

  @@map("users")
}

model TenantMembership {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  role       Role
  invitedAt  DateTime  @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@map("tenant_memberships")
}

model MediaAsset {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  key       String
  url       String
  thumbKey  String   @map("thumb_key")
  thumbUrl  String   @map("thumb_url")
  width     Int
  height    Int
  bytes     Int
  title     String?
  tags      String[] @default([])
  altText   String   @default("") @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("media_assets")
}

model Product {
  id                      String   @id @default(cuid())
  tenantId                String   @map("tenant_id")
  title                   String
  slug                    String
  description             String   @default("")
  price                   Int      @default(0)
  discountPrice           Int?     @map("discount_price")
  // The price affiliates pay when they resell this product — the source of
  // truth for AffiliatesService's cap/markup math whenever it's set, instead
  // of `price`. Null means "same as the regular price".
  affiliatePrice          Int?     @map("affiliate_price")
  // Hides this product from every affiliate, including any invited later —
  // checked at AffiliateRelationship.accept() time and reflected live by
  // deleting/never-creating an AffiliateProductListing for it. Hiding from
  // only *some* affiliates instead is AffiliateProductExemption, per
  // relationship — the two aren't mutually exclusive, this one just wins.
  hiddenFromAllAffiliates Boolean  @default(false) @map("hidden_from_all_affiliates")
  sku                     String   @default("")
  stock                   Int      @default(0)
  // When false, this product is always shown/orderable as in stock — the
  // stock number stops mattering (and stops being shown). For made-to-order
  // or otherwise never-runs-out items, same idea as a pre-order but for
  // anytime bespoke/unlimited items rather than a scheduled release.
  trackStock              Boolean  @default(true) @map("track_stock")
  isActive                Boolean  @default(true) @map("is_active")
  images                  String[] @default([])
  videoUrls               String[] @default([]) @map("video_urls")
  tags                    String[] @default([])
  displayOrder            Int      @default(0) @map("display_order")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  collections CollectionProduct[]

  affiliateExemptions AffiliateProductExemption[]
  affiliateListings   AffiliateProductListing[]   @relation("AffiliateListedProduct")

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("products")
}

model Collection {
  id                String         @id @default(cuid())
  tenantId          String         @map("tenant_id")
  title             String
  slug              String
  description       String         @default("")
  coverImage        String         @default("") @map("cover_image")
  // When set, this replaces coverImage as the link-preview (og:image) photo
  // for this collection's public URL — an explicit opt-in the vendor makes
  // from the flyer generator, never automatic. Null means "use the cover
  // photo," same as before this existed.
  unfurlImage       String?        @map("unfurl_image")
  seoTitle          String         @default("") @map("seo_title")
  seoDescription    String         @default("") @map("seo_description")
  tags              String[]       @default([])
  themeOverride     Json?          @map("theme_override")
  type              CollectionType @default(STANDARD)
  depositType       DepositType?   @map("deposit_type")
  depositPercentage Int?           @map("deposit_percentage")
  fulfillmentNote   String         @default("") @map("fulfillment_note")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  products CollectionProduct[]

  affiliateItems AffiliateCollectionItem[] @relation("AffiliateCollectionItems")

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id")
  productId    String @map("product_id")
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

model PaymentMethod {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  type        PaymentMethodType
  label       String
  details     Json
  isEnabled   Boolean           @default(true) @map("is_enabled")
  isPreferred Boolean           @default(false) @map("is_preferred")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("payment_methods")
}

model Order {
  id                   String       @id @default(cuid())
  tenantId             String       @map("tenant_id")
  customerName         String       @map("customer_name")
  customerContact      String       @map("customer_contact")
  customerEmail        String       @map("customer_email")
  status               OrderStatus  @default(PENDING)
  items                Json
  total                Int
  trackingToken        String       @unique @map("tracking_token")
  paymentReference     String       @unique @map("payment_reference")
  history              Json
  type                 OrderType    @default(STANDARD)
  depositType          DepositType? @map("deposit_type")
  depositPercentage    Int?         @map("deposit_percentage")
  depositAmount        Int?         @map("deposit_amount")
  balanceAmount        Int?         @map("balance_amount")
  balancePaid          Boolean      @default(false) @map("balance_paid")
  balancePaidAt        DateTime?    @map("balance_paid_at")
  balanceRequestedAt   DateTime?    @map("balance_requested_at")
  whatsappNumber       String?      @map("whatsapp_number")
  deliveryAddress      String?      @map("delivery_address")
  preorderCollectionId String?      @map("preorder_collection_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  confirmedAt          DateTime?    @map("confirmed_at")
  completedAt          DateTime?    @map("completed_at")
  seenByAdminAt        DateTime?    @map("seen_by_admin_at")

  // AFFILIATE orders are auto-created on the owner's tenant alongside the
  // affiliate's own customer-facing (DIRECT) order — see AffiliatesService/
  // OrdersService.create. originatingOrderId is only set on that owner-side
  // mirror row, pointing back at the affiliate's order; affiliateTenantId is
  // set on both rows.
  source             OrderSource @default(DIRECT)
  affiliateTenantId  String?     @map("affiliate_tenant_id")
  originatingOrderId String?     @unique @map("originating_order_id")

  tenant           Tenant @relation(fields: [tenantId], references: [id])
  originatingOrder Order? @relation("MirroredOrder", fields: [originatingOrderId], references: [id])
  mirroredOrder    Order? @relation("MirroredOrder")

  @@index([tenantId])
  @@map("orders")
}

// The relationship between a product owner ("owner tenant") and a reselling
// shop ("affiliate tenant"). One row per pair — re-inviting after a DECLINED
// or TERMINATED relationship reuses this same row (status flips back to
// PENDING) rather than creating a duplicate, so `history` always holds the
// full lifecycle for a given pair.
model AffiliateRelationship {
  id                 String           @id @default(cuid())
  ownerTenantId      String           @map("owner_tenant_id")
  affiliateTenantId  String           @map("affiliate_tenant_id")
  status             AffiliateStatus  @default(PENDING)
  capType            AffiliateCapType @map("cap_type")
  capValue           Int              @map("cap_value")
  invitedAt          DateTime         @default(now()) @map("invited_at")
  invitedByUserId    String           @map("invited_by_user_id")
  respondedAt        DateTime?        @map("responded_at")
  respondedByUserId  String?          @map("responded_by_user_id")
  terminatedAt       DateTime?        @map("terminated_at")
  terminatedByUserId String?          @map("terminated_by_user_id")
  // Append-only audit trail — same {status/event, note, at}[] convention as
  // Order.history. Drives the in-app activity feed; no separate
  // notifications table.
  history            Json             @default("[]")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  ownerTenant     Tenant @relation("AffiliateAsOwner", fields: [ownerTenantId], references: [id])
  affiliateTenant Tenant @relation("AffiliateAsAffiliate", fields: [affiliateTenantId], references: [id])

  exemptions AffiliateProductExemption[]
  listings   AffiliateProductListing[]

  @@unique([ownerTenantId, affiliateTenantId])
  @@index([affiliateTenantId, status])
  @@index([ownerTenantId, status])
  @@map("affiliate_relationships")
}

// A row here means the owner has hidden this product from this specific
// affiliate — default is "all visible", exemption is the opt-out.
model AffiliateProductExemption {
  id             String   @id @default(cuid())
  relationshipId String   @map("relationship_id")
  productId      String   @map("product_id")
  createdAt      DateTime @default(now()) @map("created_at")

  relationship AffiliateRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([relationshipId, productId])
  @@map("affiliate_product_exemptions")
}

// "This owner product is shown on the affiliate's own shop" — created in
// bulk when a relationship is accepted (one row per non-exempt owner
// product), independent of any collection placement.
model AffiliateProductListing {
  id             String   @id @default(cuid())
  relationshipId String   @map("relationship_id")
  productId      String   @map("product_id")
  // null = affiliate hasn't set a markup yet, so the effective price simply
  // floats with the owner's live price — see AffiliatesService.
  priceOverride  Int?     @map("price_override")
  isActive       Boolean  @default(true) @map("is_active")
  displayOrder   Int      @default(0) @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  relationship    AffiliateRelationship     @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  product         Product                   @relation("AffiliateListedProduct", fields: [productId], references: [id], onDelete: Cascade)
  collectionItems AffiliateCollectionItem[]

  @@unique([relationshipId, productId])
  @@index([relationshipId])
  @@map("affiliate_product_listings")
}

// "This affiliate-listed product is also placed inside the affiliate's own
// Collection X" — kept separate from CollectionProduct (rather than reusing
// it with a cross-tenant productId) so the affiliate's native collections
// never need to know about cross-tenant products; termination is then a
// single deleteMany on AffiliateProductListing, cascading here for free.
model AffiliateCollectionItem {
  id           String   @id @default(cuid())
  listingId    String   @map("listing_id")
  collectionId String   @map("collection_id")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  listing    AffiliateProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  collection Collection              @relation("AffiliateCollectionItems", fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([listingId, collectionId])
  @@index([collectionId])
  @@map("affiliate_collection_items")
}

// A vendor's application for the "Verified" badge — full legal name, Ghana
// Card number, and a photo of the card (plus an optional selfie), reviewed
// by a SuperAdmin. One row per tenant: a rejected vendor resubmits by
// overwriting this same row rather than creating a new one, so there's
// always exactly one current application. Photos are stored via the
// *private* storage service (media/storage/private-storage.service.ts),
// never the public media bucket — idPhotoKey/selfiePhotoKey are opaque
// keys, not URLs, only ever resolved server-side behind SuperAdminGuard.
model VerificationRequest {
  id                     String                    @id @default(cuid())
  tenantId               String                    @unique @map("tenant_id")
  legalName              String                    @map("legal_name")
  ghanaCardNumber        String                    @map("ghana_card_number")
  idPhotoKey             String                    @map("id_photo_key")
  selfiePhotoKey         String?                   @map("selfie_photo_key")
  status                 VerificationRequestStatus @default(PENDING)
  rejectionReason        String?                   @map("rejection_reason")
  reviewedBySuperAdminId String?                   @map("reviewed_by_super_admin_id")
  reviewedAt             DateTime?                 @map("reviewed_at")
  submittedAt            DateTime                  @default(now()) @map("submitted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("verification_requests")
}

// Platform-level admin, entirely separate from tenant Roles (OWNER/MANAGER/
// STAFF) — not a member of any store, reviews verification applications and
// moderates tenants. Auth is a parallel Google-login path gated by this
// table: an email not present here never gets a session, full stop (see
// SuperAdminGuard). Seeded with the first superadmin in prisma/seed.ts.
model SuperAdmin {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  invitedAt  DateTime  @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("super_admins")
}

// Selltns' own MoMo/bank details, shown to vendors on the Upgrade page so
// they know where to send payment for a plan — the mirror image of the
// per-tenant PaymentMethod model, but global to the platform rather than
// scoped to one store. Same `type`/`details` shape as PaymentMethod.
model PlatformPaymentMethod {
  id          String            @id @default(cuid())
  type        PaymentMethodType
  label       String
  details     Json
  isEnabled   Boolean           @default(true) @map("is_enabled")
  isPreferred Boolean           @default(false) @map("is_preferred")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("platform_payment_methods")
}

// A single editable row of free-text instructions shown alongside the
// platform payment methods on the Upgrade page (e.g. "include your shop
// name as the payment reference"). Always exactly one row — the service
// creates it on first read if it doesn't exist yet.
model PlatformBillingSettings {
  id        String   @id @default(cuid())
  message   String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_billing_settings")
}

// A vendor's claim that they've paid Selltns for a plan — unlike
// VerificationRequest (one row per tenant, overwritten on resubmit), this
// keeps one row per submission so upgrade/renewal history isn't lost.
// Reviewed manually by a SuperAdmin against the reference/note the vendor
// typed in; approving sets Tenant.plan.
model UpgradeRequest {
  id                     String               @id @default(cuid())
  tenantId               String               @map("tenant_id")
  requestedPlan          PlanTier             @map("requested_plan")
  referenceNote          String               @map("reference_note")
  status                 UpgradeRequestStatus @default(PENDING)
  rejectionReason        String?              @map("rejection_reason")
  reviewedBySuperAdminId String?              @map("reviewed_by_super_admin_id")
  reviewedAt             DateTime?            @map("reviewed_at")
  submittedAt            DateTime             @default(now()) @map("submitted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("upgrade_requests")
}

// Submissions from the platform-level help/contact page (apps/web's
// /help and /[slug]/help) — not tenant-scoped admin data, so no relation
// back to Tenant; tenantId is just optional context for triage.
model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  pageUrl   String   @default("") @map("page_url")
  tenantId  String?  @map("tenant_id")
  // "platform" (default) = the site's own Help/Support form; "biibisoft" =
  // the footer's "Contact the Biibisoft team" entry point — same pipeline,
  // different destination inbox (see SupportService.submit()).
  audience  String   @default("platform")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("support_messages")
}
