generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum PaymentMethodType {
  MOMO
  BANK
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  customDomain   String?  @map("custom_domain")
  domainVerified Boolean  @default(false) @map("domain_verified")
  themeTokens    Json     @map("theme_tokens")
  createdAt      DateTime @default(now()) @map("created_at")

  memberships    TenantMembership[]
  mediaAssets    MediaAsset[]
  products       Product[]
  collections    Collection[]
  paymentMethods PaymentMethod[]

  @@map("tenants")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  googleSub String?  @unique @map("google_sub")
  createdAt DateTime @default(now()) @map("created_at")

  memberships TenantMembership[]

  @@map("users")
}

model TenantMembership {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  role       Role
  invitedAt  DateTime  @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@map("tenant_memberships")
}

model MediaAsset {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  key       String
  url       String
  thumbKey  String   @map("thumb_key")
  thumbUrl  String   @map("thumb_url")
  width     Int
  height    Int
  bytes     Int
  title     String?
  tags      String[] @default([])
  altText   String   @default("") @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("media_assets")
}

model Product {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  title        String
  slug         String
  description  String   @default("")
  price        Int      @default(0)
  sku          String   @default("")
  stock        Int      @default(0)
  isActive     Boolean  @default(true) @map("is_active")
  images       String[] @default([])
  tags         String[] @default([])
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  collections CollectionProduct[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("products")
}

model Collection {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  title          String
  slug           String
  description    String   @default("")
  coverImage     String   @default("") @map("cover_image")
  seoTitle       String   @default("") @map("seo_title")
  seoDescription String   @default("") @map("seo_description")
  tags           String[] @default([])
  themeOverride  Json?    @map("theme_override")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  products CollectionProduct[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id")
  productId    String @map("product_id")
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

model PaymentMethod {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  type        PaymentMethodType
  label       String
  details     Json
  isEnabled   Boolean           @default(true) @map("is_enabled")
  isPreferred Boolean           @default(false) @map("is_preferred")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("payment_methods")
}
