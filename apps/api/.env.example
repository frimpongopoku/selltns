# Copy this file to .env and fill in real values. .env is gitignored.

# Local Postgres connection string. Adjust user/db name to match your local setup.
DATABASE_URL="postgresql://USER@localhost:5432/selltns_dev?schema=public"

# Set to "true" locally to make `prisma db seed` also create the fake demo
# tenant/products/orders ("Akosua & Co."), on top of the superadmin row it
# always seeds. Leave unset in production — `prisma db seed` there should
# only ever bootstrap the first superadmin, never fake demo data.
SEED_DEMO_DATA="true"

# Secret used to sign session JWTs. Any long random string for local dev.
JWT_SECRET="CHANGE_ME"

# Firebase service account credentials (Firebase console > Project settings >
# Service accounts > Generate new private key). Used by firebase-admin to
# verify Google ID tokens server-side.
FIREBASE_PROJECT_ID="CHANGE_ME"
FIREBASE_CLIENT_EMAIL="CHANGE_ME"
# Paste the private_key value from the downloaded JSON as one line, with
# literal \n sequences kept as-is (don't convert to real newlines) — the app
# converts them back to real newlines at startup.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"

# The web app's own URL — used to build links in emails (order tracking,
# admin review, team invites). Not a CORS setting; CORS itself allows any
# origin, see the comment in src/main.ts for why that's fine here.
WEB_ORIGIN="http://localhost:4310"

PORT="4311"

# Cloudflare R2 (S3-compatible) bucket for the media library — product
# photos, collection covers, story images. All five must be set together or
# the API falls back to storing uploads on local disk (fine for dev, never
# for production — see media/storage/local-disk-storage.service.ts).
#
# 1. Cloudflare dashboard > R2 > Create bucket.
# 2. R2 > Manage API tokens > Create API token (Object Read & Write, scoped
#    to that bucket) for R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY.
# 3. Account ID is shown on the R2 overview page.
# 4. Connect a public custom domain to the bucket (R2 > bucket > Settings >
#    Public access) and use it as R2_PUBLIC_BASE_URL — the r2.dev dev URL
#    works too but is rate-limited and not meant for production traffic.
R2_ACCOUNT_ID="CHANGE_ME"
R2_ACCESS_KEY_ID="CHANGE_ME"
R2_SECRET_ACCESS_KEY="CHANGE_ME"
R2_BUCKET_NAME="selltns-media"
R2_PUBLIC_BASE_URL="https://media.yourdomain.com"

# A SECOND, separate R2 bucket for vendor verification documents (Ghana
# Card scans, selfies) — reuses the R2 account/API token above, but this
# bucket must stay private: do NOT connect a public custom domain or enable
# public access on it in the Cloudflare dashboard. Without this set, the
# API falls back to apps/api/private-uploads/ on local disk (fine for dev,
# never for production — see media/storage/local-disk-private-storage.service.ts).
# These files are only ever served back out through an authenticated
# superadmin-only endpoint, never a direct bucket URL.
R2_PRIVATE_BUCKET_NAME="selltns-verification"

# Brevo (https://www.brevo.com) — transactional email for order
# confirmations/notifications. Free tier: 300 emails/day, no time limit.
# Without this set, the API writes emails to apps/api/emails-sent/ instead
# of sending them (fine for dev, never for production — see
# email/console-email.service.ts).
#
# 1. Brevo dashboard > Settings > SMTP & API > API Keys > Generate a new key.
# 2. EMAIL_FROM_ADDRESS should be a sender you've verified in Brevo
#    (Settings > Senders & IP) — unverified senders get rejected.
BREVO_API_KEY="CHANGE_ME"
EMAIL_FROM_ADDRESS="orders@yourdomain.com"
EMAIL_FROM_NAME="Selltns"

# Custom domains — lets a vendor point their own domain (e.g. mintsui.com) at
# their storefront. PLATFORM_APEX_IP/PLATFORM_CNAME_TARGET are the DNS record
# values vendors are told to add. Don't guess these — go to your Vercel
# project's dashboard > Settings > Domains > Add a domain, type any domain,
# and Vercel shows you the exact current A/CNAME target to use here. These
# are shown to vendors, so keep them correct.
PLATFORM_APEX_IP="CHANGE_ME"
PLATFORM_CNAME_TARGET="CHANGE_ME"

# Without these set, custom-domain verification falls back to a plain DNS
# lookup instead of calling Vercel (fine for dev, never for production — see
# domains/manual-dns-domain-provider.service.ts). With them set, the API also
# registers the domain on the Vercel project so Vercel provisions TLS for it.
# 1. vercel.com/account/tokens > Create token, for VERCEL_API_TOKEN.
# 2. Project > Settings > General > Project ID, for VERCEL_PROJECT_ID.
# 3. Only set VERCEL_TEAM_ID if the project lives under a team, not a
#    personal account (Settings > General > Team ID).
VERCEL_API_TOKEN="CHANGE_ME"
VERCEL_PROJECT_ID="CHANGE_ME"
VERCEL_TEAM_ID=""

# Sentry (https://sentry.io) — error tracking for the API. Free "Developer"
# tier: 5k errors + 10k trace spans/month, generous enough for a while.
# Without this set, Sentry.init() no-ops (fine for dev, never for
# production — see src/instrument.ts).
# 1. sentry.io > Create project > Node.js/NestJS > copy the DSN it gives you.
# Use the SAME DSN here as apps/web's NEXT_PUBLIC_SENTRY_DSN — Sentry DSNs
# aren't secret, and one Sentry project can cover both apps.
SENTRY_DSN="CHANGE_ME"

# Where the help/contact form (apps/web's /help and /[slug]/help) sends its
# notification email. Without this set, submissions are still saved to the
# database (SupportMessage) but no email goes out — see
# src/support/support.service.ts.
PLATFORM_SUPPORT_EMAIL="CHANGE_ME"
