# Copy this file to .env and fill in real values. .env is gitignored.

# Local Postgres connection string. Adjust user/db name to match your local setup.
DATABASE_URL="postgresql://USER@localhost:5432/selltns_dev?schema=public"

# Secret used to sign session JWTs. Any long random string for local dev.
JWT_SECRET="CHANGE_ME"

# Firebase service account credentials (Firebase console > Project settings >
# Service accounts > Generate new private key). Used by firebase-admin to
# verify Google ID tokens server-side.
FIREBASE_PROJECT_ID="CHANGE_ME"
FIREBASE_CLIENT_EMAIL="CHANGE_ME"
# Paste the private_key value from the downloaded JSON as one line, with
# literal \n sequences kept as-is (don't convert to real newlines) — the app
# converts them back to real newlines at startup.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"

# Origin the API accepts CORS credentials from.
WEB_ORIGIN="http://localhost:4310"

PORT="4311"

# Cloudflare R2 (S3-compatible) bucket for the media library — product
# photos, collection covers, story images. All five must be set together or
# the API falls back to storing uploads on local disk (fine for dev, never
# for production — see media/storage/local-disk-storage.service.ts).
#
# 1. Cloudflare dashboard > R2 > Create bucket.
# 2. R2 > Manage API tokens > Create API token (Object Read & Write, scoped
#    to that bucket) for R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY.
# 3. Account ID is shown on the R2 overview page.
# 4. Connect a public custom domain to the bucket (R2 > bucket > Settings >
#    Public access) and use it as R2_PUBLIC_BASE_URL — the r2.dev dev URL
#    works too but is rate-limited and not meant for production traffic.
R2_ACCOUNT_ID="CHANGE_ME"
R2_ACCESS_KEY_ID="CHANGE_ME"
R2_SECRET_ACCESS_KEY="CHANGE_ME"
R2_BUCKET_NAME="selltns-media"
R2_PUBLIC_BASE_URL="https://media.yourdomain.com"
