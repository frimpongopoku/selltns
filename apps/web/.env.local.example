# Copy relevant lines into .env.local (gitignored) and fill in real values.

NEXT_PUBLIC_API_URL="http://localhost:4311"

# The platform's own production domain — used by src/proxy.ts to recognize
# "this is selltns itself" and skip the custom-domain lookup entirely.
# Leave as-is unless the production domain changes.
NEXT_PUBLIC_APP_DOMAIN="selltns.com"

# The platform's own full URL — used for SEO metadata (canonical/OG image
# URLs, sitemap entries). Include the protocol. Leave as-is for local dev.
NEXT_PUBLIC_SITE_URL="http://localhost:4310"

# Must match apps/api/.env's R2_PUBLIC_BASE_URL — next.config.ts reads it to
# allow that hostname for next/image. Leave unset in local dev to just use
# the API's local-disk storage fallback (served from NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_MEDIA_BASE_URL=""

# Firebase web app config (Firebase console > Project settings > General >
# Your apps > SDK setup and configuration > Config). The projectId here
# must correspond to the same Firebase project as the API's
# FIREBASE_PROJECT_ID in apps/api/.env.
NEXT_PUBLIC_FIREBASE_API_KEY="CHANGE_ME"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="CHANGE_ME"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="CHANGE_ME"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="CHANGE_ME"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="CHANGE_ME"
NEXT_PUBLIC_FIREBASE_APP_ID="CHANGE_ME"

# Sentry (https://sentry.io) — error tracking for both the storefront and
# admin dashboard. Free "Developer" tier: 5k errors + 10k trace spans/month.
# Without this set, Sentry.init() no-ops (fine for dev, never for
# production — see src/instrument.ts and src/instrument-client.ts). Use the
# same DSN as apps/api's SENTRY_DSN — one Sentry project can cover both.
NEXT_PUBLIC_SENTRY_DSN="CHANGE_ME"
# Only needed for uploading source maps during production builds (better
# stack traces in Sentry). Sentry dashboard > Settings > Auth Tokens.
# Safe to leave unset for local dev.
SENTRY_AUTH_TOKEN=""

# WhatsApp number shown on the help page (apps/web's /help and /[slug]/help)
# as a "message us" option — digits only or with country code, either works
# (see src/lib/phone.ts's toWhatsAppNumber). Leave unset to hide that button
# and only show the contact form.
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=""

# PostHog (https://posthog.com) — product usage analytics (pageviews,
# autocaptured clicks, admin identify-by-user/tenant/role). Free tier: 1M
# events/month. Without this set, analytics is fully disabled (no script
# loads at all) — see src/components/analytics/posthog-tracker.tsx.
# 1. posthog.com > Project settings > Project API key.
NEXT_PUBLIC_POSTHOG_KEY="CHANGE_ME"
# Region-specific ingestion host — use https://eu.i.posthog.com if your
# PostHog project is on the EU cloud instead of US.
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
